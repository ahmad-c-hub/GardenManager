# Neon Postgres connection string (sslmode=require is needed for Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Long random string used to sign auth tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional
# Server port, default 3000. Render sets this for you. The Vite dev proxy reads it too.
PORT=3000
# Set to "production" on Render: serves client/dist, marks the session cookie Secure,
# and trusts Render's proxy for client IPs.
NODE_ENV=development
# Comma-separated extra origins allowed to call the API cross-origin (e.g. a future
# Android app's WebView origin). Leave empty: the web app is same-origin and needs none.
ALLOWED_ORIGIN=
# Web push (VAPID). Generate a pair once with: npx --prefix server web-push generate-vapid-keys
# Keep the same keys forever: changing them breaks every existing subscription.
# Without all three, the app runs normally but notifications are switched off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services if something goes wrong: mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com
# Cloudinary, for Moments photos and photos sent to the Planting Assistant (Dashboard → Settings → API Keys / Product environment).
# Server-side only: the secret is never sent to the browser. Without these, Moments can't upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google Gemini, for the Planting Assistant (free key: https://aistudio.google.com/apikey).
# Server-side only: never exposed to the browser. Without a key the assistant page says it isn't set up.
GEMINI_API_KEY=
# Optional model override. To switch provider entirely, edit server/lib/llm.js.
GEMINI_MODEL=gemini-3.5-flash
# Used when the main model is still overloaded (503) after its retries. Leave empty to turn off.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# IANA timezone for reminder times (daily 08:00, monthly on the 1st at 09:00).
REMINDER_TIMEZONE=UTC
# ISO 4217 currency code for money shown in the app (e.g. USD, EUR, GBP).
# Read at build time, so on Render set it before the build runs.
VITE_CURRENCY=USD
