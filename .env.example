# Neon Postgres connection string (sslmode=require is needed for Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Long random string used to sign auth tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional
# Server port, default 3000. Render sets this for you. The Vite dev proxy reads it too.
PORT=3000
# Set to "production" on Render: serves client/dist, marks the session cookie Secure,
# and trusts Render's proxy for client IPs.
NODE_ENV=development
# Comma-separated extra origins allowed to call the API cross-origin (e.g. a future
# Android app's WebView origin). Leave empty: the web app is same-origin and needs none.
ALLOWED_ORIGIN=
# ISO 4217 currency code for money shown in the app (e.g. USD, EUR, GBP).
# Read at build time, so on Render set it before the build runs.
VITE_CURRENCY=USD
